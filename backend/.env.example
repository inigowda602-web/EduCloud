# Copy this file to .env and fill in real values. Never commit the real .env.

# ---- Database ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=educloud
DB_USERNAME=root
DB_PASSWORD=your-mysql-password

# ddl-auto: use "update" for local dev, "validate" once you manage schema via migrations
DDL_AUTO=update
SHOW_SQL=false
# "always" seeds data.sql on every startup against an empty schema; set to "never" after first run in shared environments
SQL_INIT_MODE=always

# ---- JWT ----
# Generate a strong secret, e.g.: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-base64-secret
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Mail (Spring Boot Mail / SMTP) ----
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-app-password
MAIL_FROM=no-reply@educloud.local
MAIL_FAIL_SILENTLY=true

# ---- Frontend ----
FRONTEND_BASE_URL=http://localhost:5173

# ---- Gemini AI (backend-only, NEVER exposed to the frontend) ----
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# ---- File uploads ----
UPLOAD_DIR=./uploads

# ---- Logging ----
LOG_LEVEL=INFO
SECURITY_LOG_LEVEL=WARN
